      "passthrough": false,
      "n_jobs": 1
    }
  },
  "importance_options": {
    "kernel_shap": {"background": 3, "evaluations": 3}
  },
  "loop_study": {
    "models": [
      "randomforest", "lasso", "svm", "br", "gp", "xgboost", "cart",
