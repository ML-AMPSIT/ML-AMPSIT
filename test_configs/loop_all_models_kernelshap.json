    "region_indices": [1],
    "importance_methods": ["kernel_shap"],
    "feature_transforms": ["none"],
    "tuning": 0,
    "selected_timestep": 2,
    "sobol_samples": 16,
    "parallel_workers": 2,
    "timesteps": [2, 3],
    "plot_kinds": ["performance", "prediction", "importance", "temporal", "uncertainty", "ensemble", "symbolic"],
    "comparison_kinds": ["spatial", "temporal"]
  }
