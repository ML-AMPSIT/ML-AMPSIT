{
  "base_config": "config_loop.json",
  "case_name": "Ishigami tuned Loop model comparison",
  "output_pathname": "outputs/loop_tuning",
  "tun_iter": 16,
  "tuning_workers": 1,
  "tuning_spaces": {
    "randomforest": {
      "n_estimators": {"type": "integer", "low": 100, "high": 700},
      "max_depth": {"type": "integer", "low": 2, "high": 18},
      "min_samples_split": {"type": "integer", "low": 2, "high": 12},
      "min_samples_leaf": {"type": "integer", "low": 1, "high": 8},
      "max_features": {"type": "categorical", "values": ["sqrt", "log2", null]},
      "bootstrap": {"type": "categorical", "values": [true, false]}
    },
    "gp": {
      "alpha": {"type": "real", "low": 0.00000001, "high": 0.1, "prior": "log-uniform"},
      "n_restarts_optimizer": {"type": "integer", "low": 0, "high": 4},
      "kernel__length_scale": {"type": "real", "low": 0.05, "high": 20.0, "prior": "log-uniform"},
      "kernel__alpha": {"type": "real", "low": 0.05, "high": 20.0, "prior": "log-uniform"}
    },
    "symbolic": {
      "population_size": {"type": "integer", "low": 100, "high": 400},
      "generations": {"type": "integer", "low": 10, "high": 40},
      "tournament_size": {"type": "integer", "low": 3, "high": 12},
      "max_depth": {"type": "integer", "low": 3, "high": 7},
      "crossover_rate": {"type": "real", "low": 0.55, "high": 0.85},
      "mutation_rate": {"type": "real", "low": 0.1, "high": 0.4},
      "parsimony_coefficient": {"type": "real", "low": 0.000001, "high": 0.02, "prior": "log-uniform"}
    },
    "stacking": {}
  },
  "loop_study": {
    "tuning": 1
  }
}
